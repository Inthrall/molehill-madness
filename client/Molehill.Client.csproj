<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!--
      net9.0 rather than the net8.0 Godot's editor assemblies use, because the 4.7.2
      Android export template only accepts net9.0. Getting this wrong fails the export
      with a clear message rather than at runtime, which is the good kind of wrong.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <!-- So the same build also runs on a machine with only the .NET 10 runtime. -->
    <RollForward>LatestMajor</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!--
    The client consumes the simulation and never the other way round. MoleSim targets
    netstandard2.1 precisely so that whatever engine ends up rendering the game can pick
    it up unchanged.
  -->
  <ItemGroup>
    <ProjectReference Include="..\sim\MoleSim\MoleSim.csproj" />
    <!--
      The online flow, which has no engine types in it precisely so that it can be tested against
      a real relay without booting Godot. The client supplies the screens; that project supplies
      everything that could desync a match.
    -->
    <ProjectReference Include="..\online\Molehill.Online\Molehill.Online.csproj" />
    <!--
      The clip pipeline: the drama scorer and the animated PNG writer, both engine-free so both can
      be tested without booting Godot. The client's only job here is to supply pixels.
    -->
    <ProjectReference Include="..\clip\Molehill.Clip\Molehill.Clip.csproj" />
  </ItemGroup>

</Project>
