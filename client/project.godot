; Molehill Madness client.
;
; The Phase 0 probe is still here and still runnable: it is the thing that proved
; the simulation agrees across two CPU architectures, and it stays as a check that
; can be re-run on any new device. The game itself is scenes/Match.tscn.

config_version=5

[application]

config/name="Molehill Madness"
config/description="Four platoons, one screen, everything happening at once."
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; Either way round, but never portrait. The touch layout puts the wheel and the fire
; button under one thumb and the plan controls under the other, which needs the width.
window/handheld/orientation=4

[dotnet]

project/assembly_name="Molehill.Client"

[importer_defaults]

; Mipmaps on every texture, because every texture in this game is drawn smaller than it is
; stored. A dirt tile is a thousand texels over six metres of map, so at the normal framing
; every neighbouring fragment reads a texel four apart and the texture cache is useless; a
; grass tuft shrunk from a hundred and sixty pixels to sixty without them aliases into
; dashes. Set here rather than on each file so art added later cannot quietly miss it.
texture={
"mipmaps/generate": true
}

[rendering]

; Compatibility rather than Forward+, because the widest possible spread of
; Android hardware matters more to this game than any modern rendering feature.
; It is a hand-drawn 2D game; there is nothing here Forward+ would buy.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Required for any Android export. Costs nothing here because the probe draws with
; primitives rather than textures, but the real client will need it regardless.
textures/vram_compression/import_etc2_astc=true
