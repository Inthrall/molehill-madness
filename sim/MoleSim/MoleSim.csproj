<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests can see inside. Nothing else can, and the assembly still references nothing, which is
    what the CI guard actually checks. It is here for one thing: the state hash covers the random
    generator now, and the only way to test that it does is to move the generator without moving
    anything else, which is not something any caller outside the simulation should be able to do.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="MoleSim.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MoleSim</RootNamespace>
    <AssemblyName>MoleSim</AssemblyName>

    <!-- The simulation must never drift. Warnings are defects. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Deterministic builds, so the same source always yields the same assembly. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    MoleSim deliberately references nothing. No engine types, no I/O, no third-party
    packages. If something here needs a dependency, it belongs in a consumer instead.
  -->

</Project>
